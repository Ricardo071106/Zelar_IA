# Tools
ENABLE_WHATSAPP_BOT=true
# Telegram: só sobe com true (opt-in). Token sozinho não inicia mais o polling.
TELEGRAM_BOT_ENABLED=false
REQUIRE_TELEGRAM=false
WHATSAPP_AUTH_DIR=./server/whatsapp/auth_info_baileys

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_AUDIO_MODEL=openrouter/free
OPENROUTER_AUDIO_FALLBACK_MODEL=openrouter/free
AUDIO_TRANSCRIPTION_AUDIT_LOG=false

# SMTP (opcional, alternativa gratuita ao SendGrid - ex: Gmail App Password)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PAYMENT_LINK=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Application URLs
BASE_URL=http://localhost:8080
# Segredo longo e aleatório para emitir o token de sessão após login no painel (/painel/entrar) e OAuth — obrigatório em produção
PANEL_TOKEN_SECRET=
# Opcional: user.id numérico + linha em system_calendar_integrations (integration_key abaixo)
DEFAULT_ORGANIZER_USER_ID=
DEFAULT_ORGANIZER_INTEGRATION_KEY=default_google_organizer
# Conta Google Zelar no banco: integration_key padrão zelar_google_invites + tokens JSON na tabela
ZELAR_CALENDAR_INTEGRATION_KEY=zelar_google_invites
# ID interno só para cache OAuth (não precisa existir em users)
ZELAR_CALENDAR_OAUTH_USER_ID=999001
RESTART_WEBHOOK_TOKEN=
RESTART_WEBHOOK_URL=
AUTO_RESTART_AT_MIDNIGHT=false
AUTO_RESTART_TZ=America/Sao_Paulo
AUTO_RESTART_CRON=0 0 * * *

# Others
# Com TELEGRAM_BOT_ENABLED=true e token preenchido o bot sobe
TELEGRAM_BOT_TOKEN=
DATABASE_URL=

# Pluggy (Open Finance — conciliação de PIX por nome + valor; omita para desativar rotas que exigem chave)
# Sandbox: no dashboard Pluggy use a API key do ambiente de desenvolvimento / equipe de testes.
# A API costuma ser a mesma URL (https://api.pluggy.ai); o que muda é a chave e o conector "Sandbox" no widget.
PLUGGY_API_KEY=
# Webhook Pluggy: use o mesmo BASE_URL da seção "Application URLs" acima (URL pública HTTPS em homologação/produção).
# Opcional: exige header X-Zelar-Pluggy-Secret igual a este valor nas chamadas POST /api/pluggy/webhook
PLUGGY_WEBHOOK_SECRET=
# Opcional: override da API Pluggy
# PLUGGY_API_BASE_URL=https://api.pluggy.ai
# Painel (Vite): em build de produção, true = widget lista conectores Sandbox (só para homologação).
# Em dev (npm run dev) o sandbox já aparece automaticamente.
# VITE_PLUGGY_INCLUDE_SANDBOX=true

# Banco: aplique migrations até 0013 (dedupe de webhooks Pluggy — tabela pluggy_processed_transactions)