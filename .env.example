# Tools
ENABLE_WHATSAPP_BOT=true
# Telegram: só sobe com true (opt-in). Token sozinho não inicia mais o polling.
TELEGRAM_BOT_ENABLED=false
REQUIRE_TELEGRAM=false
WHATSAPP_AUTH_DIR=./server/whatsapp/auth_info_baileys

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=

# LLM local (Ollama — sobe junto no Docker via scripts/docker-entrypoint.sh)
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:3b-instruct
LLM_API_KEY=ollama
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_MODELS=./.ollama-models
OLLAMA_AUTO_PULL=true
  # LLM_TIMEOUT_MS=90000
# Conciliação Pluggy + Ollama: por padrão interpreta TODO lançamento (nome/CPF/valor)
# PLUGGY_LLM_EXTRACT=false desliga; PLUGGY_LLM_EXTRACT=fallback só quando regex não achar nome/CPF
# PLUGGY_LLM_EXTRACT=always (opcional, igual ao padrão)

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PAYMENT_LINK=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Application URLs
BASE_URL=http://localhost:8080
# Segredo longo e aleatório para emitir o token de sessão após login no painel (/painel/entrar) e OAuth — obrigatório em produção
PANEL_TOKEN_SECRET=
# Opcional: segredo longo para HMAC de CPF/CNPJ de alunos. Se vazio, usa PANEL_TOKEN_SECRET.
CPF_HASH_SECRET=
# Opcional: user.id numérico + linha em system_calendar_integrations (integration_key abaixo)
DEFAULT_ORGANIZER_USER_ID=
DEFAULT_ORGANIZER_INTEGRATION_KEY=default_google_organizer
# Conta Google Zelar no banco: integration_key padrão zelar_google_invites + tokens JSON na tabela
ZELAR_CALENDAR_INTEGRATION_KEY=zelar_google_invites
# ID interno só para cache OAuth (não precisa existir em users)
ZELAR_CALENDAR_OAUTH_USER_ID=999001
RESTART_WEBHOOK_TOKEN=
RESTART_WEBHOOK_URL=
AUTO_RESTART_AT_MIDNIGHT=false
AUTO_RESTART_TZ=America/Sao_Paulo
AUTO_RESTART_CRON=0 0 * * *

# Others
# Com TELEGRAM_BOT_ENABLED=true e token preenchido o bot sobe
TELEGRAM_BOT_TOKEN=
DATABASE_URL=

# Pluggy (Open Finance — extrato: só nome do pagador + valor; aulas pagas desde a 1ª aula criada do aluno)
# Recomendado (igual quickstart oficial Pluggy): Application → Client ID + Client Secret → o servidor troca em POST /auth.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Alternativa: chave de API (X-API-KEY). Se PLUGGY_API_KEY estiver preenchida, ela tem prioridade sobre CLIENT_ID/SECRET.
PLUGGY_API_KEY=
# Webhook Pluggy: use o mesmo BASE_URL da seção "Application URLs" acima (URL pública HTTPS em homologação/produção).
# Opcional: exige header X-Zelar-Pluggy-Secret igual a este valor nas chamadas POST /api/pluggy/webhook
PLUGGY_WEBHOOK_SECRET=
# Opcional: true/1/yes = webhooks Pluggy também conciliam transações automaticamente (padrão = só via /buscar no WhatsApp).
# PLUGGY_AUTO_WEBHOOK_SYNC=true
# Conciliação por valor exato (ex. R$ 4 = 2× R$ 2) está sempre ativa no /buscar; nome/CPF no extrato desambigua se vários alunos baterem o valor.
# CPF sozinho só entra no saldo se o valor fechar N×preço da aula (evita PIX de teste entre contas próprias).
# Opcional: como interpretar o campo `amount` do Pluggy (BRL). Padrão: reais × 100, mas se o extrato tiver "R$ 14,00" o servidor escolhe automaticamente entre reais e centavos.
# Se o banco mandar valores já em centavos sem texto de referência: PLUGGY_AMOUNT_IN_CENTS=true
# PLUGGY_AMOUNT_IN_CENTS=true
# Forçar sempre reais × 100 (ignora heurística do texto): PLUGGY_AMOUNT_IN_REAIS=true
# PLUGGY_AMOUNT_IN_REAIS=true
# Opcional: override da API Pluggy
# PLUGGY_API_BASE_URL=https://api.pluggy.ai
# Painel (Vite): em build de produção, true = widget lista conectores Sandbox (só para homologação).
# Em dev (npm run dev) o sandbox já aparece automaticamente.
# VITE_PLUGGY_INCLUDE_SANDBOX=true

# Banco: migrations Pluggy — 0013 (dedupe pluggy_processed_transactions) e 0015 (ledger pluggy_contact_payment_ledger)